# Intelligent Document Processing - Environment Configuration
# Copy this file to .env and adjust values as needed.

# === Paths ===
# IDP_DATA_DIR=backend/data
# IDP_UPLOAD_DIR=backend/uploads
# IDP_DATABASE_PATH=backend/data/documents.db

# === Tesseract OCR ===
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# === Model Configuration ===
# O2: LayoutLMv3 for structured extraction
IDP_LAYOUTLM_MODEL=nielsr/layoutlmv3-finetuned-funsd

# O3: Document QA
IDP_QA_MODEL=impira/layoutlm-document-qa

# Model cache directory (stores downloaded weights)
# IDP_MODELS_CACHE=backend/model_cache

# === Confidence Thresholds ===
IDP_CONFIDENCE_HIGH=0.80
IDP_CONFIDENCE_MEDIUM=0.50

# === Upload Limits ===
IDP_MAX_UPLOAD_MB=20

# === Server ===
# IDP_HOST=127.0.0.1
# IDP_PORT=8000
# IDP_LOG_LEVEL=INFO
